<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_fill" />
            <corners android:radius="@dimen/navbar_dock_radius" />
        </shape>
    </item>
    <!-- Gloss: a bright sheen across the top half. -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270"
                android:startColor="@color/glass_highlight_top"
                android:centerColor="@color/glass_highlight_bottom"
                android:endColor="@color/glass_highlight_bottom" />
            <corners android:radius="@dimen/navbar_dock_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1.5dp" android:color="@color/glass_rim" />
            <corners android:radius="@dimen/navbar_dock_radius" />
        </shape>
    </item>
</layer-list>
