<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="NavBarText">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:singleLine">true</item>
        <item name="android:shadowColor">@color/text_shadow</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">6</item>
    </style>

    <style name="NavBarText.Primary">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/navbar_text_primary</item>
    </style>

    <style name="NavBarText.Secondary">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/navbar_text_secondary</item>
    </style>

    <style name="NavButton">
        <item name="android:layout_width">@dimen/nav_button_size</item>
        <item name="android:layout_height">@dimen/nav_button_size</item>
        <item name="android:padding">@dimen/nav_button_padding</item>
        <item name="android:tint">@color/nav_icon_tint</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="DetailTitle">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/detail_title_text</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="DetailText">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/detail_text</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="ActionButton" parent="android:Widget.Button">
        <item name="android:layout_height">@dimen/action_button_height</item>
        <item name="android:paddingHorizontal">@dimen/action_button_padding</item>
        <item name="android:background">@drawable/action_button_background</item>
        <item name="android:textColor">@color/action_button_text</item>
        <item name="android:textSize">@dimen/action_button_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="AppLabel">
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/app_label_color</item>
        <item name="android:textSize">@dimen/app_label_text</item>
    </style>

    <style name="OptionsDialog" parent="android:Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.7</item>
    </style>


    <style name="SettingsDropdown">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">@dimen/dropdown_indent</item>
        <item name="android:paddingTop">@dimen/settings_row_gap</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="SettingRowTitle">
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/row_text</item>
        <item name="android:textSize">@dimen/settings_row_text</item>
    </style>

    <style name="SettingRowValue">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/row_text_dim</item>
        <item name="android:textSize">@dimen/settings_row_text</item>
    </style>

    <style name="PagePlaceholderText">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/page_placeholder_text</item>
    </style>

    <style name="NavBarDivider">
        <item name="android:layout_width">@dimen/navbar_divider_width</item>
        <item name="android:layout_height">@dimen/navbar_divider_height</item>
        <item name="android:layout_marginHorizontal">@dimen/navbar_divider_margin</item>
        <item name="android:background">@color/text_primary</item>
    </style>
</resources>
