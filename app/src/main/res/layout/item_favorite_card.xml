<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/picker_card_width"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="@dimen/picker_card_margin">

    <com.nison.freedeck.ui.common.AspectFrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/app_card_background"
        app:aspectRatio="1.7778"
        app:cornerRadius="@dimen/app_card_radius">

        <ImageView
            android:id="@+id/pick_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <!-- A plus when selecting adds the app to the favorites, a minus when it takes it out. -->
        <ImageView
            android:id="@+id/pick_badge"
            android:layout_width="@dimen/picker_badge_size"
            android:layout_height="@dimen/picker_badge_size"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="@drawable/picker_badge_background"
            android:importantForAccessibility="no"
            android:padding="4dp"
            android:tint="@color/badge_icon" />
    </com.nison.freedeck.ui.common.AspectFrameLayout>

    <TextView
        android:id="@+id/pick_label"
        style="@style/AppLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:duplicateParentState="true" />
</LinearLayout>
