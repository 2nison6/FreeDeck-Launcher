<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/navbar_height"
    android:clipChildren="false"
    android:background="@drawable/navbar_scrim"
    android:clipToPadding="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/screen_margin_horizontal"
    android:paddingVertical="@dimen/navbar_padding_vertical">

    <!-- Greeting | Time | Date, then Location | Weather. Each piece can be hidden from Settings. -->
    <LinearLayout
        android:id="@+id/navbar_text_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/navbar_top_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/navbar_greeting"
                style="@style/NavBarText.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <View
                android:id="@+id/navbar_divider_time"
                style="@style/NavBarDivider" />

            <!-- The digits, then AM / PM in a smaller size on the same baseline. -->
            <LinearLayout
                android:id="@+id/navbar_time_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/navbar_time"
                    style="@style/NavBarText.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/navbar_time_suffix"
                    style="@style/NavBarText.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/navbar_suffix_gap"
                    android:textSize="@dimen/navbar_text_suffix" />
            </LinearLayout>

            <View
                android:id="@+id/navbar_divider_date"
                style="@style/NavBarDivider" />

            <TextView
                android:id="@+id/navbar_date"
                style="@style/NavBarText.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/navbar_text_date" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navbar_bottom_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/navbar_row_spacing"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/navbar_location"
                style="@style/NavBarText.Secondary"
                android:textColor="@color/text_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <View
                android:id="@+id/navbar_weather_divider"
                style="@style/NavBarDivider" />

            <LinearLayout
                android:id="@+id/navbar_weather_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/navbar_weather_icon"
                    android:layout_width="@dimen/navbar_icon_size"
                    android:layout_height="@dimen/navbar_icon_size"
                    android:importantForAccessibility="yes" />

                <TextView
                    android:id="@+id/navbar_temperature"
                    style="@style/NavBarText.Secondary"
                    android:textColor="@color/text_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/navbar_icon_spacing" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- The dock: one highlight slides behind the buttons to whichever one has focus, flush with the dock's edge. -->
    <FrameLayout
        android:id="@+id/navbar_dock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/glass_dock"
        android:clipChildren="false"
        android:clipToPadding="false">

        <View
            android:id="@+id/nav_highlight"
            android:layout_width="@dimen/nav_button_size"
            android:layout_height="@dimen/nav_button_size"
            android:background="@drawable/nav_highlight"
            android:visibility="invisible" />

        <LinearLayout
            android:id="@+id/navbar_buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:divider="@drawable/nav_button_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:showDividers="middle">

        <com.nison.freedeck.ui.home.navbar.NavIconButton
            android:id="@+id/nav_home"
            android:nextFocusLeft="@+id/nav_wifi"
            android:nextFocusRight="@+id/nav_apps"
            android:nextFocusDown="@+id/home_grid"
            style="@style/NavButton"
            android:contentDescription="@string/nav_home"
            android:src="@drawable/ic_nav_home" />

        <com.nison.freedeck.ui.home.navbar.NavIconButton
            android:id="@+id/nav_apps"
            android:nextFocusLeft="@+id/nav_home"
            android:nextFocusRight="@+id/nav_settings"
            android:nextFocusDown="@+id/apps_grid"
            style="@style/NavButton"
            android:contentDescription="@string/nav_apps"
            android:src="@drawable/ic_nav_apps" />

        <com.nison.freedeck.ui.home.navbar.NavIconButton
            android:id="@+id/nav_settings"
            android:nextFocusDown="@+id/setting_default_launcher"
            android:nextFocusLeft="@+id/nav_apps"
            android:nextFocusRight="@+id/nav_wifi"
            style="@style/NavButton"
            android:contentDescription="@string/nav_settings"
            android:src="@drawable/ic_nav_settings" />

        <com.nison.freedeck.ui.home.navbar.WifiButton
            android:id="@+id/nav_wifi"
            android:nextFocusLeft="@+id/nav_settings"
            android:nextFocusRight="@+id/nav_home"
            android:nextFocusDown="@+id/wifi_more_settings"
            style="@style/NavButton"
            android:contentDescription="@string/nav_wifi"
            android:src="@drawable/ic_nav_wifi" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
