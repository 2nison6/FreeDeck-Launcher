<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The chosen background gradient, behind Home and All Apps only. -->
    <ImageView
        android:id="@+id/background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />


    <!-- Settings lives in the area below the nav bar and clips at its bottom edge. Home and Apps are full screen so
         their colour glow also lights the nav bar; their content sits below the bar. The Wi-Fi map is full screen too. -->
    <com.nison.freedeck.ui.home.pages.HomePage
        android:id="@+id/page_home"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.nison.freedeck.ui.home.pages.AppsPage
        android:id="@+id/page_apps"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.nison.freedeck.ui.home.pages.SettingsPage
        android:id="@+id/page_settings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="true"
        android:layout_marginTop="@dimen/navbar_height" />

    <com.nison.freedeck.ui.home.pages.WifiPage
        android:id="@+id/page_wifi"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.nison.freedeck.ui.home.navbar.NavBarView
        android:id="@+id/navbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/navbar_height"
        android:layout_gravity="top" />

</merge>
