<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/card_background"
    android:orientation="vertical"
    android:padding="@dimen/wifi_card_padding">

    <TextView
        style="@style/DetailTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:text="@string/favorite_picker_title" />

    <!-- Two cards across; the height is set in code to exactly three rows, and further rows scroll in. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/picker_list"
        android:layout_width="@dimen/picker_list_width"
        android:layout_height="@dimen/picker_list_height"
        android:layout_marginTop="@dimen/detail_button_margin"
        android:clipToPadding="true" />
</LinearLayout>
