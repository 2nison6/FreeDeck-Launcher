<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:clipChildren="false"
    android:focusable="true"
    android:longClickable="true"
    android:orientation="vertical"
    android:padding="@dimen/app_card_margin">

    <!-- Rounded and clipped, so banners, icons and the favorite badge all share the same corners. -->
    <com.nison.freedeck.ui.common.AspectFrameLayout
        android:id="@+id/app_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/app_card_background"
        app:aspectRatio="1.7778"
        app:cornerRadius="@dimen/app_card_radius">

        <ImageView
            android:id="@+id/app_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <!-- Favorite badge: a ribbon hanging from the top edge, holding a heart in the app's accent colour. -->
        <FrameLayout
            android:id="@+id/app_favorite"
            android:layout_width="@dimen/favorite_ribbon_width"
            android:layout_height="@dimen/favorite_ribbon_height"
            android:layout_gravity="top|end"
            android:layout_marginEnd="@dimen/favorite_ribbon_margin_end"
            android:contentDescription="@string/app_favorite_badge"
            android:visibility="gone">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/ic_favorite_ribbon" />

            <ImageView
                android:id="@+id/app_favorite_heart"
                android:layout_width="@dimen/favorite_heart_size"
                android:layout_height="@dimen/favorite_heart_size"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="@dimen/favorite_heart_margin_top"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_favorite_heart" />
        </FrameLayout>
    </com.nison.freedeck.ui.common.AspectFrameLayout>

    <TextView
        android:id="@+id/app_label"
        style="@style/AppLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:duplicateParentState="true" />

</LinearLayout>
